{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "biblioteca-anarquista-beta",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "beta.antarquia.cl",
      "custom_domain": true
    }
  ]
}
