{
  "name": "archivo-historico-anarquista",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Archivo histórico interactivo del movimiento anarquista con línea temporal, mapa de regiones, biografías y biblioteca de textos",
  "author": "Tu Nombre",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run lint && npm test && npm run build",
    "check-downloads": "node scripts/check-downloads.mjs",
    "generate-worldmap": "node scripts/generate-worldmap.mjs",
    "lint": "eslint src --ext .js,.jsx"
  },
  "dependencies": {
    "d3-geo": "^2.0.2",
    "lucide-react": "^0.263.1",
    "prop-types": "^15.8.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^4.0.0",
    "@vitest/coverage-v8": "^1.6.1",
    "autoprefixer": "^10.4.14",
    "eslint": "^8.45.0",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^4.6.2",
    "jsdom": "^30.0.1",
    "postcss": "^8.4.24",
    "tailwindcss": "^3.3.0",
    "topojson-client": "^3.1.0",
    "vite": "^4.3.9",
    "vitest": "^1.6.1"
  }
}
